# Production environment for the EduKZ backend.
# Copy to backend/.env on the server and fill in real values:
#   cp backend/.env.production.example backend/.env
#
# NEVER commit the real backend/.env.

PORT=5000

# Local MongoDB on the server. Use a strong DB name; add auth if Mongo is exposed.
MONGO_URI=mongodb://127.0.0.1:27017/edu_platform

# CHANGE THIS to a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=__change_me_to_a_long_random_secret__

JWT_EXPIRES=30d

# Public site origin (used for CORS). Same-origin in this setup, but keep accurate.
CLIENT_URL=https://edu-platform.online
